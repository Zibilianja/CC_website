# Copy to .env and fill in values.

# NASA DONKI — exposed to browser (use DEMO_KEY or your own key; rate limited)
VITE_NASA_API_KEY=

# OpenWeather — SERVER ONLY. Never use VITE_ prefix (would bundle the key into the site).
OPENWEATHER_API_KEY=

# Production only: Lambda Function URL from functions/template.yaml deploy.
# Example: https://abc123.lambda-url.us-east-1.on.aws
# VITE_OPENWEATHER_PROXY_URL=
